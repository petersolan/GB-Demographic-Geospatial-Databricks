{
  "datasets": [
    {
      "name": "lsoa",
      "displayName": "LSOA calibration (gold)",
      "queryLines": [
        "SELECT lsoa21_code, lsoa21_name, CASE lad_code WHEN 'E07000040' THEN 'East Devon' WHEN 'E07000041' THEN 'Exeter' WHEN 'E07000042' THEN 'Mid Devon' WHEN 'E07000045' THEN 'Teignbridge' ELSE lad_code END AS district,\n",
        "       residents, registered_synthetic, registered_nhs,\n",
        "       synthetic_per_resident, nhs_per_resident, postcodes_since_census,\n",
        "       CASE WHEN nhs_per_resident < 1 THEN 1 ELSE 0 END AS nhs_below_one, nhs_extract\n",
        "FROM lsoa_calibration\n",
        "ORDER BY nhs_per_resident DESC\n"
      ]
    },
    {
      "name": "district",
      "displayName": "District comparison (gold)",
      "queryLines": [
        "WITH d AS (\n",
        "  SELECT CASE lad_code WHEN 'E07000040' THEN 'East Devon' WHEN 'E07000041' THEN 'Exeter' WHEN 'E07000042' THEN 'Mid Devon' WHEN 'E07000045' THEN 'Teignbridge' ELSE lad_code END AS district, SUM(residents) AS residents,\n",
        "         SUM(registered_synthetic) AS synthetic, SUM(registered_nhs) AS nhs\n",
        "  FROM lsoa_calibration GROUP BY 1\n",
        ")\n",
        "SELECT district, 'Synthetic' AS list, ROUND(100 * (synthetic / residents - 1), 1) AS pct_above_residents FROM d\n",
        "UNION ALL\n",
        "SELECT district, 'Real (NHS England)' AS list, ROUND(100 * (nhs / residents - 1), 1) FROM d\n"
      ]
    },
    {
      "name": "practice",
      "displayName": "Practice calibration (gold)",
      "queryLines": [
        "SELECT practice_code, practice_name, registered_synthetic, registered_nhs,\n",
        "       registered_synthetic - registered_nhs AS synthetic_minus_real\n",
        "FROM practice_calibration\n",
        "WHERE coalesce(registered_synthetic, 0) >= 100 OR coalesce(registered_nhs, 0) >= 100\n",
        "ORDER BY abs(registered_synthetic - registered_nhs) DESC\n"
      ]
    },
    {
      "name": "monthly",
      "displayName": "Registered by month (gold)",
      "queryLines": [
        "SELECT month_end, CASE lad_code WHEN 'E07000040' THEN 'East Devon' WHEN 'E07000041' THEN 'Exeter' WHEN 'E07000042' THEN 'Mid Devon' WHEN 'E07000045' THEN 'Teignbridge' ELSE lad_code END AS district, registered\n",
        "FROM registered_monthly\n"
      ]
    },
    {
      "name": "updates",
      "displayName": "Monthly update files (gold)",
      "queryLines": [
        "SELECT extract_month, measure,\n",
        "       CASE measure WHEN 'quarantined' THEN item\n",
        "            ELSE initcap(lower(replace(item, '_', ' '))) END AS item,\n",
        "       events\n",
        "FROM update_summary\n"
      ]
    },
    {
      "name": "applied",
      "displayName": "Events applied (gold)",
      "queryLines": [
        "SELECT extract_month, initcap(lower(replace(item, '_', ' '))) AS item, events\n",
        "FROM update_summary WHERE measure = 'applied'\n"
      ]
    },
    {
      "name": "quarantined",
      "displayName": "Events quarantined (gold)",
      "queryLines": [
        "SELECT extract_month, replace(item, '_', ' ') AS item, events\n",
        "FROM update_summary WHERE measure = 'quarantined'\n"
      ]
    },
    {
      "name": "points",
      "displayName": "LSOA map points (gold)",
      "queryLines": [
        "SELECT c.lsoa21_code, c.lsoa21_name, CASE lad_code WHEN 'E07000040' THEN 'East Devon' WHEN 'E07000041' THEN 'Exeter' WHEN 'E07000042' THEN 'Mid Devon' WHEN 'E07000045' THEN 'Teignbridge' ELSE lad_code END AS district, p.lat, p.lon,\n",
        "       c.residents, c.registered_nhs, c.nhs_per_resident, c.synthetic_per_resident\n",
        "FROM lsoa_calibration c JOIN lsoa_points p USING (lsoa21_code)\n"
      ]
    }
  ],
