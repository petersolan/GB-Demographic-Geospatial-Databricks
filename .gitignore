# Data stays out of git (downloads are large and re-creatable by scripts).
# Leading slash = repo root only, so site/data/ (protected aggregates for the site) is kept.
/data/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/

# Spark / Delta local artefacts
spark-warehouse/
metastore_db/
derby.log

# Databricks
.databricks/
.databrickscfg
.env

# Wheel build leftovers (the bundle builds dist/*.whl on deploy)
build/
dist/
*.egg-info/
